{
  "name": "sp-front",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/sp-front/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "define": {
          "API_URL": "\"https://localhost:43802/api/v1\"",
          "AUTH_URL": "\"http://localhost:5003/api/v1\"",
          "APP_URL": "\"http://localhost:4200\"",
          "AUTH_BOT_NAME": "\"ppokerTest_bot\"",
          "EXCHANGE_URL": "\"https://devex.safe-poker.ru\""
        },
        "outputPath": "dist/apps/sp-front",
        "index": "apps/sp-front/src/index.html",
        "browser": "apps/sp-front/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/sp-front/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/sp-front/src/assets",
          {
            "glob": "**/*",
            "input": "apps/sp-front/public"
          },
          {
            "glob": "**/*",
            "input": "./libs/shared-assets/",
            "output": "./assets"
          },
          {
            "glob": "**/*",
            "input": "node_modules/@taiga-ui/icons/src",
            "output": "assets/taiga-ui/icons"
          }
        ],
        "styles": [
          "node_modules/@videogular/ngx-videogular/fonts/videogular.css",
          "node_modules/@taiga-ui/core/styles/taiga-ui-theme.less",
          "node_modules/@taiga-ui/core/styles/taiga-ui-fonts.less",
          "./libs/shared-styles/styles.scss",
          "apps/sp-front/src/styles.scss"
        ],
        "scripts": [ "node_modules/hls.js/dist/hls.min.js"],
        "server": "apps/sp-front/src/main.server.ts",
        "prerender": false,
        "ssr": {
          "entry": "apps/sp-front/server.ts"
        }
      },
      "configurations": {
        "dev": {
          "index": "apps/sp-front/src/index.dev.html",
          "define": {
            "API_URL": "\"https://dev.safe-poker.ru/learn/api/v1\"",
            "AUTH_URL": "\"https://dev.safe-poker.ru/api/v1\"",
            "APP_URL": "\"https://dev.safe-poker.ru/learn\"",
            "AUTH_BOT_NAME": "\"devPokerPayTest_bot\"",
            "EXCHANGE_URL": "\"https://dev.safe-poker.ru\""
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "production": {
          "index": "apps/sp-front/src/index.prod.html",
          "define": {
            "API_URL": "\"https://old.safe-poker.io/learn/api/v1\"",
            "AUTH_URL": "\"https://old.safe-poker.io/api/v1\"",
            "APP_URL": "\"https://old.safe-poker.io/learn\"",
            "AUTH_BOT_NAME": "\"safepoker_bot\"",
            "EXCHANGE_URL": "\"https://old.safe-poker.io\""
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "sp-front:build:production"
        },
        "development": {
          "buildTarget": "sp-front:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "sp-front:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/sp-front/jest.config.ts"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "sp-front:build",
        "port": 4200,
        "staticFilePath": "dist/apps/sp-front/browser",
        "spa": true
      }
    }
  }
}
